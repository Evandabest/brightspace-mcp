{
  "name": "brightspace-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Brightspace tools for student AI assistants",
  "type": "module",
  "bin": {
    "brightspace-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit && npm test",
    "setup": "npm run build && node dist/index.js setup",
    "login": "npm run build && node --env-file-if-exists=.env dist/index.js login",
    "logout": "npm run build && node --env-file-if-exists=.env dist/index.js logout",
    "browser:install": "playwright install chromium",
    "test:browser": "node --import tsx --test test/browser.integration.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
