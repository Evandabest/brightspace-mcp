BRIGHTSPACE_BASE_URL=https://brightspace.cuny.edu
# Browser mode: use npm run browser:install, then npm run login.
BRIGHTSPACE_AUTH_MODE=browser
# For a registered OAuth application instead, set AUTH_MODE=oauth and supply:
# BRIGHTSPACE_ACCESS_TOKEN=replace-with-your-oauth-access-token
# Use versions supported by your institution.
BRIGHTSPACE_LP_VERSION=1.49
BRIGHTSPACE_LE_VERSION=1.82
# Saved browser sessions are encrypted with a key kept in the OS keychain. Only if this
# computer has no keychain (e.g. headless Linux), opt in to unencrypted storage with:
# BRIGHTSPACE_INSECURE_PLAINTEXT_SESSION=1
